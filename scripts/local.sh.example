#!/usr/bin/env bash
# Template for scripts/local.sh — copy to scripts/local.sh and edit (it is gitignored: your rig's settings stay
# out of the repo). Trusted Bash: it is SOURCED, so anything Bash can do works here (computed values, conditionals).
# Precedence: the exported environment beats this file; this file beats .env; .env beats the defaults in knobs.sh.
#   TUNE=agents CONC=4 ./glm53 up   # the exported values win, whatever this file or .env say
# Examples — uncomment and set:
# The tier and the concurrency dial (knobs.sh):
#TUNE=agents
#CONC=4
# The memory-reserve layer (needs an image with the attic client, README "The memory-reserve layer"):
#ATTIC=1
#GR8_IMAGE=gr8:e231adb-attic
# The busy guard (needs an image with the guard):
#BUSY=1
#BUSY_IDLE_SECS=60
# Engine settings ride the one EXTRA_ENV line (UPDATE 2); this file may add words to what .env sets:
#EXTRA_ENV="${EXTRA_ENV:+$EXTRA_ENV }GR8_GEN_CACHE=/var/lib/gr8/cache/gen-cache"
# This rig's boxes (README "The four boxes"):
#PEERS=10.0.0.1,10.0.0.2,10.0.0.3,10.0.0.4
#IPS=10.0.0.1,10.0.0.2,10.0.0.3,10.0.0.4
#IPS2=10.0.1.1,10.0.1.2,10.0.1.3,10.0.1.4
# install: where the recipe folder lives on the other boxes, and the ssh user for them:
#INSTALL_PEER_DIR=/opt/glm53-4x-spark
#INSTALL_SSH_USER=bertholomus

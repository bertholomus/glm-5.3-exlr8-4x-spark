# Copy to .env next to compose.yaml on all four boxes, the same file on each. Compose passes every line into the
# container, where the gr8 launcher reads it as an option. Unset lines take the launcher's default (./gr8 knobs).

# --- the model (pinned to the commits measured in README.md) -----------------------------------------------------------
GR8_MODEL=glm53
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4@9372b74d77e129ea063bc0934df1570fc3173469
# glm53 at TP=4 drafts with the DFlash2 drafter (gr8 docs/DEPLOY.md). Its licence is CC BY-NC-ND 4.0: it forbids
# sharing a converted copy, so EACH BOX downloads the drafter and converts its own rank part (./fetch, ./gr8 prepare).
# Pinned like MODEL (see incoai/GLM-5.3-DFlash2@425aa61...); drop the @<commit> to follow the repo's main.
DRAFTER=https://huggingface.co/incoai/GLM-5.3-DFlash2@425aa615ce320caac34400208b30808c8f14f76c
# The width manifest: bit275 (the default, shipped in manifests/), home, bit325, bit338, up1, bit225, bit243, bit260, down1, or a path to a
# custom exlr8-v2-manifest JSON. ./gr8 knobs VARIANT says what each shipped one is.
#VARIANT=bit275
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- the four boxes ----------------------------------------------------------------------------------------------------
# Placeholders: put THIS cluster's addresses in. The 10G LAN address of every box, in rank order, head first; the head
# serves the OpenAI API on port 8100. TP is the number of addresses.
PEERS=192.0.2.1,192.0.2.2,192.0.2.3,192.0.2.4
TP=4
# Each box's ConnectX address on PCIe root 1 (IPS) and PCIe root 2 (IPS2), in PEERS order. Unset, the boxes find each other through mentat, or use one NIC per rail's default.
IPS=10.0.0.1,10.0.0.2,10.0.0.3,10.0.0.4
IPS2=10.0.1.1,10.0.1.2,10.0.1.3,10.0.1.4
# No switch: the boxes are cabled in a ring, in PEERS cable order; leave out IPS and IPS2.
#SHAPE=ring

# --- the knobs (README.md, "Pick what to prioritize") -------------------------------------------------------------------
# What to prioritize: quality (the default, measured), speed, context, agents or agents-fast (knobs.sh; agents = quality
# with SHARE_LIMIT=16384, measured 2026-11-09; agents-fast = agents + GR8_REUSE_ALIGN=0, opt-in, NOT bit-exact against a
# cold prefill). The speed slot was removed: its two measured knobs were no gain (knobs 3-5 cancelled).
#TUNE=quality
# The requests that decode at once. Unset: 8, gr8's TP=4 default. The concurrency floor for a winning config is SESS>=4.
#SESS=8
# The concurrency dial: CONC=1|2|4|8 sets SESS and lets CAP follow the largest CAP a boot at that SESS measured
# holding the serving floor (9 GiB free at ready, never under 8 under load) — fewer slots, more KV cache per
# session. Unset: the recipe default CONC=4 (the serving choice; ./glm53 conc prints the table for the current
# VARIANT). A CAP you set keeps your value (one above the measured value warns on ./glm53 up). A pair with no
# measured row falls back to SESS=CONC and this TUNE's CAP, with a stderr line.
#CONC=4
# The memory-reserve layer (spark-attic, github.com/bertholomus/spark-attic): ATTIC=1 boots with
# compose.attic.yaml (the layer lends each rank its display-carveout slice, so the CONC rows with attic on
# hold a bigger pool) and needs GR8_IMAGE to name an image WITH the attic client — the pinned
# ghcr.io/kindlingai/gr8:sha-e231adb has none and the boot is refused with the fix named. The recipe accepts an
# image whose name contains "attic" (a gr8 build with the attic client, e.g. GR8_IMAGE=gr8:e231adb-attic). Default 0.
#ATTIC=0
# The KV pool in tokens, shared by the sessions. Unset: 485376 at fp8; TUNE=context sets 513536 (KV_FORMAT=int4).
#CAP=485376
# 0: the boxes in PEERS. 1: find the boxes through the host's mentat daemon, in group GROUP.
#MENTAT=0
#GROUP=gr8-glm53-4x
# The busy guard (README, "The busy guard"): BUSY=1 refuses a request that would evict a retained session's KV
# (HTTP 429 + Retry-After) instead of evicting it or queueing it in silence. Needs GR8_IMAGE to name an image WITH
# the guard (github.com/bertholomus/gr8 branch busy-guard until the PR merges upstream); the pinned image has none
# and the boot is refused with the fix named. Optional knobs: BUSY_IDLE_SECS, BUSY_RETRY_AFTER, BUSY_QUEUE_MAX.
#BUSY=0

# --- Optional tier: SSD KV persistence (off by default in v2; README "Switching and the SSD KV store tier") ---------------
# At an orderly stop the engine writes the chats it holds to the store; the next boot reads the index back, so a
# chat's next turn restores its KV instead of a prefill. GR8_STOP_GRACE gives docker's stop the time that write needs
# (compose.yaml reads it for stop_grace_period): without it docker kills the engine mid-store. Measured cost and the
# honest base note (our numbers ran keep=all on gr8 a555ee2; Chuck's newer store work is newer than that base) are
# in the README. Uncomment BOTH lines to turn the tier on.
#KV_STORE=ssd:/var/lib/gr8/cache/kv,size=200G,persist=on,keep=sessions
#GR8_STOP_GRACE=150s

# --- faster restarts and engine knobs ------------------------------------------------------------------------------------
# GR8_GEN_CACHE: the loader keeps the tensors it computes at load on this box's disk and reads them back at the next
# boot of the same image (SWITCHING.md). The first boot of an image writes it.
#
# UPDATE 2 (Kindling, 2026-11-07, verified on this rig): GR8_* engine knobs reach the engine ONLY through EXTRA_ENV.
# A plain GR8_FOO=... line in .env is dropped by the launcher (a -e GR8_MOE_TOPK=6 never reached engine.env; a
# -e EXTRA_ENV=GR8_MOE_TOPK=6 did). Append new GR8_* knobs to this ONE line, space-separated NAME=value, and never
# replace what is already here. Short launcher names (SESS, CAP, KV_FORMAT, DFLASH_K, ...) stay plain lines above.
EXTRA_ENV=GR8_GEN_CACHE=/var/lib/gr8/cache/gen-cache

# --- the image (read by compose, not the launcher) -----------------------------------------------------------------------
# Pinned to the build the rows in README.md were measured on (digest sha256:d920e26b...).
GR8_IMAGE=ghcr.io/kindlingai/gr8:sha-e231adb
# A host directory for this box's part of the release (~90 GB at TP=4), owned by uid 1000, in place of the cache volume.
#GR8_CACHE=/srv/glm53/cache
# A host directory for logs and state (out/, s2/, run/), owned by uid 1000, in place of the home volume.
#GR8_HOME=/srv/glm53/home

# --- other ---------------------------------------------------------------------------------------------------------------
# Files the fetch takes at once (gr8's downloader).
#FETCH_JOBS=8
# Any other gr8 launcher option (gr8/KNOBS.md) works here too, as NAME=VALUE. Engine settings ride EXTRA_ENV (above).
